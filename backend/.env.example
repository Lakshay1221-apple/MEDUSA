# MEDUSA Backend Configuration

PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medusa_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="medusa_super_secret_jwt_access_key_12345"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="medusa_super_secret_jwt_refresh_key_67890"
JWT_REFRESH_EXPIRATION="7d"

# Security & Encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Object Storage (S3 / Local Fallback)
STORAGE_DRIVER="local" # "s3" or "local"
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="medusa-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# GitHub OAuth Integration
GITHUB_CLIENT_ID="mock_github_client_id"
GITHUB_CLIENT_SECRET="mock_github_client_secret"

# AI / LLM Configuration
LLM_PROVIDER="mock" # "openai", "anthropic", "gemini", or "mock"
LLM_API_KEY="mock_llm_key"

# Web Push Notification VAPID Keys
WEB_PUSH_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSPOEgIMfSTKEppmScxMrLNbdBDuPBOyKGL8"
WEB_PUSH_PRIVATE_KEY="mock_web_push_private_key"
WEB_PUSH_SUBJECT="mailto:admin@medusa.app"

# Scoring Engine Defaults
SCORE_SCHEDULED_POINTS=10
SCORE_HABIT_POINTS=5
SCORE_SKIP_PENALTY=-15
SCORE_ABANDON_PENALTY=-25
SCORE_PERFECT_DAY_BONUS=20
SCORE_DEEP_WORK_PER_15MIN=1
SCORE_GITHUB_VERIFICATION_POINTS=15
